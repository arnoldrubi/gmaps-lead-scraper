    {
      "parameters": {
        "jsCode": "const rawLeads = $input.first().json.leads || [];\n\nreturn rawLeads.map(lead => {\n  // Strip Google Maps icon characters and newlines from Phone and Address\n  const cleanPhone = (lead.Phone || '').replace(/^[^\\d+]+/, '').trim();\n  const cleanAddress = (lead.Address || '').replace(/^[\\uE000-\\uF8FF\\s\\n]+/, '').trim();\n\n  // Clean URL-encoded spaces (%20) from emails\n  const cleanPrimaryEmail = decodeURIComponent(lead.Primary_Email || '').trim();\n  const cleanAllEmails = decodeURIComponent(lead.All_Emails || '')\n    .split(',')\n    .map(e => e.trim())\n    .filter(e => e && !/^first\\.last@/i.test(e))\n    .join(', ');\n\n  return {\n    json: {\n      ...lead,\n      Phone: cleanPhone,\n      Address: cleanAddress,\n      Primary_Email: /^first\\.last@/i.test(cleanPrimaryEmail) ? '' : cleanPrimaryEmail,\n      All_Emails: cleanAllEmails\n    }\n  };\n});"
      },
